{
  "name": "medibook",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant Clinic Management SaaS and Medical Marketplace (monorepo)",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/shared-types",
    "packages/shared-utils",
    "packages/validation",
    "packages/design-tokens",
    "packages/auth",
    "packages/api-client",
    "apps/backend",
    "apps/admin-web",
    "apps/clinic-web",
    "apps/patient-web",
    "apps/patient-mobile",
    "apps/staff-mobile"
  ],
  "scripts": {
    "dev": "npm run dev -w @medibook/backend",
    "dev:worker": "npm run dev:worker -w @medibook/backend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @medibook/backend",
    "migrate": "npm run migrate -w @medibook/backend",
    "migrate:status": "npm run migrate:status -w @medibook/backend",
    "migrate:create": "npm run migrate:create -w @medibook/backend --",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:config": "docker compose config --quiet",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "test:auth": "npm run test:auth -w @medibook/backend",
    "test:authorization": "npm run test:authorization -w @medibook/backend",
    "test:tenant": "npm run test:tenant -w @medibook/backend",
    "test:security": "npm run test:security -w @medibook/backend",
    "test:api": "npm run test:api -w @medibook/backend",
    "secrets:generate": "npm run secrets:generate -w @medibook/backend",
    "role:grant": "npm run role:grant -w @medibook/backend --",
    "role:revoke": "npm run role:revoke -w @medibook/backend --",
    "test:platform": "npm run test:platform -w @medibook/backend",
    "test:clinic-setup": "npm run test:clinic-setup -w @medibook/backend",
    "test:bookings": "npm run test:bookings -w @medibook/backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "~4.1.12"
  }
}
