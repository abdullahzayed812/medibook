{
  "name": "@medibook/validation",
  "version": "0.0.0",
  "private": true,
  "description": "Shared validation schemas used by backend and clients.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
