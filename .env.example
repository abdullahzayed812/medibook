# Docker Compose development environment.
#   cp .env.example .env
# Fill in EVERY empty value. Generate secrets locally, e.g.:  openssl rand -hex 24
# .env is git-ignored; never commit real credentials. Never use real patient data.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=medibook
MYSQL_USER=medibook
MYSQL_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Backend auth secrets ---
# Generate all four with:  npm run secrets:generate   (prints ready-to-paste lines)
AUTH_SECRET=
AUTH_ACCESS_TOKEN_PRIVATE_KEY=
AUTH_ACCESS_TOKEN_KEY_ID=
MFA_ENCRYPTION_KEY=
# Optional ISO country (e.g. IQ) to accept local phone numbers without "+". Empty = E.164 only.
PHONE_DEFAULT_REGION=

# --- Host ports (bound to 127.0.0.1). Change if a port is already in use. ---
BACKEND_HOST_PORT=3000
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379

# --- Backend logging ---
LOG_LEVEL=debug
LOG_PRETTY=true
