# Backend configuration for running the API/worker/migrations/integration tests on the HOST
# (outside Docker) against the Compose MySQL and Redis.
#   cp apps/backend/.env.example apps/backend/.env
# Values must match the root .env used by Docker Compose. Never commit .env.
# Full reference: docs/development/ENVIRONMENT_SETUP.md

NODE_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medibook
DB_USER=medibook
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

QUEUE_PREFIX=medibook

# Auth secrets: generate with `npm run secrets:generate` (must match the root .env when sharing
# a database with the Docker backend, otherwise existing OTP challenges/MFA secrets won't verify).
AUTH_SECRET=
AUTH_ACCESS_TOKEN_PRIVATE_KEY=
AUTH_ACCESS_TOKEN_KEY_ID=
MFA_ENCRYPTION_KEY=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SESSION_MAX_LIFETIME_SECONDS=7776000

# Development only; rejected when NODE_ENV=production.
OTP_PROVIDER=mock
PHONE_DEFAULT_REGION=
HTTP_TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=15000
HEALTH_CHECK_TIMEOUT_MS=2000
